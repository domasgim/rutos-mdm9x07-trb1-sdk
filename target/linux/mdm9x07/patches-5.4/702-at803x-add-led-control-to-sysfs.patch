--- a/drivers/net/phy/at803x.c
+++ b/drivers/net/phy/at803x.c
@@ -14,6 +14,9 @@
 #include <linux/etherdevice.h>
 #include <linux/of_gpio.h>
 #include <linux/gpio/consumer.h>
+#include <linux/leds.h>
+#include <linux/ethtool.h>
+#include <linux/mdio.h>
 
 #define AT803X_SPECIFIC_STATUS			0x11
 #define AT803X_SS_SPEED_MASK			(3 << 14)
@@ -39,6 +42,12 @@
 
 #define AT803X_SMART_SPEED			0x14
 #define AT803X_LED_CONTROL			0x18
+#define AT803X_LED_MANUAL_CONTROL		0x19
+
+#define AT803X_LED_MASK				0xFFF0
+#define AT803X_LED_ACT_ON			0xF
+#define AT803X_LED_ACT_OFF			0xA
+#define AT803X_LED_ACT_STATUS			0x0
 
 #define AT803X_DEVICE_ADDR			0x03
 #define AT803X_LOC_MAC_ADDR_0_15_OFFSET		0x804C
@@ -54,8 +63,8 @@
 #define AT803X_MODE_CFG_MASK			0x0F
 #define AT803X_MODE_CFG_SGMII			0x01
 
-#define AT803X_PSSR			0x11	/*PHY-Specific Status Register*/
-#define AT803X_PSSR_MR_AN_COMPLETE	0x0200
+#define AT803X_PSSR				0x11	/*PHY-Specific Status Register*/
+#define AT803X_PSSR_MR_AN_COMPLETE		0x0200
 
 #define AT803X_DEBUG_REG_0			0x00
 #define AT803X_DEBUG_RX_CLK_DLY_EN		BIT(15)
@@ -74,7 +83,18 @@ MODULE_DESCRIPTION("Atheros 803x PHY dri
 MODULE_AUTHOR("Matus Ujhelyi");
 MODULE_LICENSE("GPL");
 
+enum {
+	AT803X_PORT_LED_ACT_OFF = 0,
+	AT803X_PORT_LED_ACT_ON = 1,
+	AT803X_PORT_LED_ACT_STATUS = 2
+};
+
 struct at803x_priv {
+	struct mdio_device mdio;
+	struct phy_device *phydev;
+	struct led_classdev led;
+    int register_flag;
+
 	bool phy_reset:1;
 };
 
@@ -243,16 +263,71 @@ static int at803x_resume(struct phy_devi
 	return phy_modify(phydev, MII_BMCR, BMCR_PDOWN | BMCR_ISOLATE, 0);
 }
 
+static void at803x_led_set_mode(struct led_classdev *cdev, enum led_brightness mode)
+{
+	struct at803x_priv *priv = container_of(cdev, struct at803x_priv, led);
+	int reg;
+	int mask;
+
+	reg = mdiobus_read(priv->mdio.bus, priv->mdio.addr, AT803X_LED_MANUAL_CONTROL);
+
+	if (mode < 0)
+		mode = 0;
+	else if (mode > 0)
+		mode = 2;
+
+
+	switch(mode) {
+		case AT803X_PORT_LED_ACT_OFF:
+			mask = AT803X_LED_ACT_OFF;
+			break;
+		case AT803X_PORT_LED_ACT_STATUS:
+			mask = AT803X_LED_ACT_STATUS;
+			break;
+		default:
+			return;
+	}
+
+	reg &= AT803X_LED_MASK;
+	reg |= mask;
+
+	mdiobus_write(priv->mdio.bus, priv->mdio.addr, AT803X_LED_MANUAL_CONTROL, reg);
+	priv->register_flag = mode;
+
+	return 0;
+}
+
+static enum led_brightness at803x_led_get_brightness(struct led_classdev *cdev)
+{
+	struct at803x_priv *priv = container_of(cdev, struct at803x_priv, led);
+	return priv->register_flag;
+}
+
 static int at803x_probe(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
 	struct at803x_priv *priv;
+	int ret = 0;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
 	phydev->priv = priv;
+	priv->mdio = phydev->mdio;
+	priv->phydev = phydev;
+	priv->led.name = "eth_led";
+	priv->led.max_brightness = 2;
+	priv->led.brightness_set = at803x_led_set_mode;
+	priv->led.brightness_get = at803x_led_get_brightness;
+
+	ret = led_classdev_register(dev, &priv->led);
+	if (ret) {
+		dev_err(dev, "LED registration failed!\n");
+		return ret;
+	}
+
+	at803x_led_set_mode(&priv->led, AT803X_LED_ACT_STATUS);
 
 	return 0;
 }
