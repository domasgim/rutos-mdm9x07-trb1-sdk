diff --git a/target/mdm9607/init.c b/target/mdm9607/init.c
index a487ce7..88532f8 100755
--- a/target/mdm9607/init.c
+++ b/target/mdm9607/init.c
@@ -98,6 +98,34 @@ static struct ptable flash_ptable;
 
 struct qpic_nand_init_config config;
 
+#ifdef USE_FASTBOOT_LED_IND
+/* Array of GPIO that controls signal strength leds. */
+static int sig_arr[] = { 25, 10, 42, 11, 24 };
+
+#define SIG_ARR_LEN (sizeof(sig_arr) / sizeof(sig_arr[0]))
+
+void dev_led_setup(void)
+{
+	int i;
+
+	for (i = 0; i < SIG_ARR_LEN; i++) {
+		gpio_tlmm_config(sig_arr[i], 0, GPIO_OUTPUT, GPIO_PULL_DOWN,
+				 GPIO_2MA, GPIO_ENABLE);
+		gpio_set_val(sig_arr[i], GPIO_ENABLE);
+	}
+}
+
+int dev_led_work(void)
+{
+	int i;
+	uint32_t stat = gpio_status(sig_arr[0]);
+
+	for (i = 0; i < SIG_ARR_LEN; i++) {
+		gpio_set_val(sig_arr[i], !stat);
+	}
+}
+#endif
+
 void update_ptable_names(void)
 {
 	uint32_t ptn_index;
@@ -173,6 +201,10 @@ void target_init(void)
 	uint32_t base_addr;
 	uint8_t slot;
 
+#ifdef USE_FASTBOOT_LED_IND
+	dev_led_setup();
+#endif
+
 	dprintf(INFO, "target_init()\n");
 
 	spmi_init(PMIC_ARB_CHANNEL_NUM, PMIC_ARB_OWNER_ID);
