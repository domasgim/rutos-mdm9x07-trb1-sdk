+
 typedef struct
 {
 	int (*udc_init)(struct udc_device *devinfo);
@@ -539,6 +543,17 @@ again:
 	free(buffer);
 }
 
+#ifdef USE_FASTBOOT_LED_IND
+static int led_ind_handler(void *arg)
+{
+	for (;;) {
