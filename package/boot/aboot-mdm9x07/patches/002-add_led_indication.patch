 		goto fail_alloc_in;
 	}
 	thread_resume(thr);
+#ifdef USE_FASTBOOT_LED_IND
+	led_thr = thread_create("led_ind", led_ind_handler, 0, DEFAULT_PRIORITY, 4096);
+	if (!led_thr)
