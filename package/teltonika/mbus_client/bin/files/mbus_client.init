#!/bin/sh /etc/rc.common

USE_PROCD=1
START=88
STOP=88

APP=/usr/sbin/mbus_client
CONFIG=mbus_client

if [ ! -x "$APP" ]; then
	APP="/usr/local$APP"
fi

start_service() {
	config_load "$CONFIG"

	config_get ENABLED "main" "enabled" "0"
	[ "$ENABLED" = "0" ] && return

	procd_open_instance
	procd_set_param command "$APP"
	procd_set_param respawn "${respawn_threshold:-0}" "${respawn_timeout:-60}" "${respawn_retry:-0}"
	procd_set_param user mbus_client
	procd_close_instance
}

reload_service() {
	procd_set_param file /etc/config/"$CONFIG"
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
