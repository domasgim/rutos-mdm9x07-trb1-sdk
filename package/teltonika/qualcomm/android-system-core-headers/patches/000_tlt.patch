diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/include/utils/Errors.h src/include/utils/Errors.h
--- upstream/include/utils/Errors.h	1970-01-01 00:00:00.000000000 +0000
+++ src/include/utils/Errors.h	2021-11-15 10:52:44.000000000 +0000
@@ -0,0 +1,88 @@
+/*
