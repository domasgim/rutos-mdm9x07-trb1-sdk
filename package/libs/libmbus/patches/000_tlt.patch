+char *
+mbus_data_variable_record_ascii_no_preset(mbus_data_record *record, int record_cnt, int frame_cnt, mbus_data_variable_header *header)
+{
+    static char buff[BUFF_SIZE];
+    char str_encoded[768];
+    size_t len = 0;
+    struct tm * timeinfo;
+    char timestamp[22];
+    long tariff;
+
+    if (!record) {
+        return "";
+    }
+
+    if (frame_cnt >= 0) {
+	    len += snprintf(&buff[len], sizeof(buff) - len, "%d %d ", record_cnt, frame_cnt);
+    } else {
+	    len += snprintf(&buff[len], sizeof(buff) - len, "%d ", record_cnt);
+    }
+
+    if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) { // MBUS_DIB_DIF_VENDOR_SPECIFIC {
+	    len += snprintf(&buff[len], sizeof(buff) - len, "Manufacturer specific ");
+    } else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+	    len += snprintf(&buff[len], sizeof(buff) - len, "More records follow ");
+    } else {
+        mbus_str_xml_encode(str_encoded, mbus_data_record_function(record), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s ", str_encoded);
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "%ld ", mbus_data_record_storage_number(record));
+
+	if ((tariff = mbus_data_record_tariff(record)) >= 0)
+        {
+		len += snprintf(&buff[len], sizeof(buff) - len, "%ld ", tariff);
+		len += snprintf(&buff[len], sizeof(buff) - len, "%d ", mbus_data_record_device(record));
+	}
+
+        mbus_str_xml_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+	    len += snprintf(&buff[len], sizeof(buff) - len, "%s ", str_encoded);
+    }
+
+    mbus_str_xml_encode(str_encoded, mbus_data_record_value(record), sizeof(str_encoded));
+    len += snprintf(&buff[len], sizeof(buff) - len, "%s ", str_encoded);
+
+    if (record->timestamp > 0)
+    {
+        timeinfo = gmtime (&(record->timestamp));
+        strftime(timestamp,21,"%Y-%m-%dT%H:%M:%SZ",timeinfo);
+	    len += snprintf(&buff[len], sizeof(buff) - len, "%s", timestamp);
+    }
+
+    return buff;
+}
+
+char *mbus_data_variable_header_ascii(mbus_data_variable_header *header)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768] = { 0 };
+	size_t len = 0;
+
+	if (!header) {
+		goto end;
+	}
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s ", mbus_data_get_secondary_address(header));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%llX ", mbus_data_bcd_decode_hex(header->id_bcd, 4));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s ",
+		mbus_decode_manufacturer(header->manufacturer[0], header->manufacturer[1]));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%d", header->version);
+
+	mbus_str_encode(str_encoded, mbus_data_product_name(header), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s ", str_encoded);
+
+	mbus_str_encode(str_encoded, mbus_data_variable_medium_lookup(header->medium), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s ", str_encoded);
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "%d ", header->access_no);
+	len += snprintf(&buff[len], sizeof(buff) - len, "%.2X ", header->status);
+	len += snprintf(&buff[len], sizeof(buff) - len, "%.2X%.2X", header->signature[1], header->signature[0]);
+
+	buff[len] = '\0';
+
+	return buff;
+
+end:
+	return "";
+}
