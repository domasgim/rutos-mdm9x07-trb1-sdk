+			}
+			break;
+		case INDEX_STORAGE_NUMBER:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			len += snprintf(&buff[len], sizeof(buff) - len, "%ld",
+					mbus_data_record_storage_number(record));
+			break;
+		case INDEX_TARIFF:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			if (tariff >= 0) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "%ld", tariff);
+			}
+			break;
+		case INDEX_DEVICE:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			if (tariff >= 0) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "%d",
+						mbus_data_record_device(record));
+			}
+			break;
+		case INDEX_UNIT:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			mbus_str_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+			len += snprintf(&buff[len], sizeof(buff) - len, "%s", str_encoded);
+			break;
+		case INDEX_VALUE:
+			mbus_str_encode(str_encoded, mbus_data_record_value(record),
+					     sizeof(str_encoded));
+			len += snprintf(&buff[len], sizeof(buff) - len, "%s", str_encoded);
+			break;
+		case INDEX_TIMESTAMP:
+			if (record->timestamp > 0) {
+				char timestamp[22]  = { 0 };
+				struct tm *timeinfo = gmtime(&(record->timestamp));
+				strftime(timestamp, 21, "%Y-%m-%dT%H:%M:%SZ", timeinfo);
+				len += snprintf(&buff[len], sizeof(buff) - len, "%s", timestamp);
+			}
+			break;
+		default:
+            // len += snprintf(&buff[len], sizeof(buff) - len, "<Error>parameter with ID %d was not found</Error>", rp->parameters[i]);
+			break;
+		}
+
+        loop_end: ;
+
+		// check if parameter was added previously
+		int a = ((i >= (int)(csv->parameter_count - 1)));
+		len += snprintf(&buff[len], sizeof(buff) - len, a ? "": ",");
+	}
+
+	return buff;
+}
+
+static int handle_records_csv(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			  mbus_frame *frame, mbus_frame_data *frame_data, mbus_data_variable_header *header, struct value_preset *p, struct frame_preset *fp, struct csv_information *csv)
+{
+	mbus_data_record *record = NULL;
+    	int records_added = 0;
+	// loop through all records in the current frame
+	for (record = frame_data->data_var.record; record; record = record->next, (*record_cnt)++) {
+		struct record_preset *rp = get_record(fp, (*record_cnt));
+		if (!rp) {
+			continue;
+		}
+
+		*buff = check_and_expand_buffer(*buff, len, buff_size);
+		if (!buff) {
+			mbus_data_record_free(frame_data->data_var.record);
+			return -1;
+		}
+
+		*len += snprintf(*buff + *len, *buff_size - *len, "%d,", frame->address);
+		*len += snprintf(*buff + *len, *buff_size - *len, "%s,", mbus_data_get_secondary_address(header));
+		if (p->manufacturer_info) {
+			add_manufacturer_info(*buff, len, *buff_size, *frame_data, DATA_TYPE_CSV);
+		} else if (csv->manufacturer_info) {
+		// if manufacturer information is disabled for this device, but enabled in other devices, add empty information
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s,", mbus_data_variable_header_empty_csv(header));
+		}
+
+		if (rp->take_all_parameters) {
+		    	*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+		                    mbus_data_variable_record_csv_no_preset(record, *record_cnt, frame_cnt, header));
+		} else {
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+				mbus_data_variable_record_csv(record, *record_cnt, frame_cnt, header, rp, csv));
+		}
+		*len += snprintf(*buff + *len, *buff_size - *len, "\n");
+		records_added++;
+	}
+
+	// free all records in the list
+	if (frame_data->data_var.record) {
+		mbus_data_record_free(frame_data->data_var.record);
+	}
+
+	return 0;
+}
+
+char *mbus_data_variable_csv(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p, struct csv_information *csv)
+{
+	size_t len = 0, buff_size = BUFF_SIZE;
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return NULL;
+	}
+
+    if (is_frames_required(p)) {
+        return buff;
+    }
+
+    	int frames_added = 0, frame_cnt = 0, record_cnt = 0;
+	for (mbus_frame *iter = frame; iter; iter = iter->next, frame_cnt++) {
+
+		if (mbus_frame_data_parse(iter, &frame_data) == -1) {
+			mbus_error_str_set("M-bus variable data parse error.");
+            		free(buff);
+			return NULL;
+		}
+
+		struct frame_preset *fp = get_frame(p, frame_cnt);
+		if (!fp) {
+			count_skipped_records(&frame_data, &record_cnt);
+			mbus_data_record_free(frame_data.data_var.record);
+			continue;
+		}
+
+		if (handle_records_csv(&buff, &len, &buff_size, &record_cnt, frame_cnt, frame, &frame_data, &(frame_data.data_var.header), p, fp, csv) < 0) {
+            		free(buff);
+			return NULL;
+		}
+	}
+
+	return buff;
+}
+
+char *generate_csv_header_all(void)
+{
+    return "RecordId,Frame,Function,StorageNumber,Tariff,Device,Unit,Value,Timestamp\n";
+}
+
+char *generate_csv_header_custom(struct csv_information *csv)
+{
+    static char buff[256] = { 0 };
+    int len = 0;
+
+    for (size_t i = 0; i < csv->parameter_count; i++) {
+        switch (csv->parameters[i])
+        {
+        case INDEX_RECORD_ID:
+            len += snprintf(&buff[len], sizeof(buff) - len, "RecordId");
+            break;
+        case INDEX_FRAME_ID:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Frame");
+            break;
+        case INDEX_FUNCTION:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Function");
+            break;
+        case INDEX_STORAGE_NUMBER:
+            len += snprintf(&buff[len], sizeof(buff) - len, "StorageNumber");
+            break;
+        case INDEX_TARIFF:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Tariff");
+            break;
+        case INDEX_DEVICE:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Device");
+            break;
+        case INDEX_UNIT:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Unit");
+            break;
+        case INDEX_VALUE:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Value");
+            break;
+        case INDEX_TIMESTAMP:
+            len += snprintf(&buff[len], sizeof(buff) - len, "Timestamp");
+            break;
+        default:
+            break;
+        }
+        len += snprintf(&buff[len], sizeof(buff) - len, "%s", (i < (int)(csv->parameter_count - 1)) ? "," : "\n");
+    }
+
+    return buff;
+}
+
+char *mbus_data_variable_header_csv(mbus_data_variable_header *header)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768] = { 0 };
+	size_t len = 0;
+
+	if (!header) {
+		goto end;
+	}
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "%llX,", mbus_data_bcd_decode_hex(header->id_bcd, 4));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s,",
+		mbus_decode_manufacturer(header->manufacturer[0], header->manufacturer[1]));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%d,", header->version);
+
+	mbus_str_encode(str_encoded, mbus_data_product_name(header), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s,", str_encoded);
+
+	mbus_str_encode(str_encoded, mbus_data_variable_medium_lookup(header->medium), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "%s,", str_encoded);
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "%d,", header->access_no);
+	len += snprintf(&buff[len], sizeof(buff) - len, "%.2X,", header->status);
+	len += snprintf(&buff[len], sizeof(buff) - len, "%.2X%.2X,", header->signature[1], header->signature[0]);
+
+	buff[len] = '\0';
+
+	return buff;
+
+end:
+	return "";
+}
+
+
+static char *mbus_data_variable_header_empty_csv(mbus_data_variable_header *header)
+{
+	return ",,,,,,,";
+}
