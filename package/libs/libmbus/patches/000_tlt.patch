+    case 0x4 + 1:
+    case 0x4 + 2:
+    case 0x4 + 3:
+        // E000 01nn
+        snprintf(buff, sizeof(buff), "Reserved (0x%.2x)", vib->vife[0]);
+        break;
+    case 0x8:
+    case 0x8 + 1:
+        // E000 100n
+        n = 0x01 & vib->vife[0];
+        if (n == 0)
