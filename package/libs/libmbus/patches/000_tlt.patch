+char *mbus_data_error_json(int error)
+{
+	char str_encoded[256] = { 0 };
+	size_t len = 0, buff_size = BUFF_SIZE;
+
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		return NULL;
+	}
+
+	len += snprintf(&buff[len], buff_size - len, "{\n\"SlaveInformation\": {\n");
+	mbus_str_encode(str_encoded, mbus_data_error_lookup(error), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Error\": \"%s\"\n}\n}\n", str_encoded);
+
+	return buff;
+}
+
+char *mbus_data_fixed_json(mbus_data_fixed *data)
+{
+	if (!data) {
+		return NULL;
+	}
+
+	size_t buff_size = BUFF_SIZE;
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		return NULL;
+	}
+
+	size_t len = 0;
+	len += snprintf(&buff[len], buff_size - len, "{\n\"SlaveInformation\": {\n");
+	len += snprintf(&buff[len], buff_size - len, "\"Id\": \"%llX\",\n", mbus_data_bcd_decode_hex(data->id_bcd, 4));
+
+	char str_encoded[256] = { 0 };
+	mbus_str_encode(str_encoded, mbus_data_fixed_medium(data), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Medium\": \"%s\",\n", str_encoded);
+
+	len += snprintf(&buff[len], buff_size - len, "\"AccessNumber\": %d,\n", data->tx_cnt);
+	len += snprintf(&buff[len], buff_size - len, "\"Status\": \"%.2X\"\n", data->status);
+	len += snprintf(&buff[len], buff_size - len, "},\n");
+
+	len += snprintf(&buff[len], buff_size - len, "\"DataRecords\": [\n");
+
+	len += snprintf(&buff[len], buff_size - len, "{\n");
+
+	mbus_str_encode(str_encoded, mbus_data_fixed_function(data->status), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Function\": \"%s\",\n", str_encoded);
+
+	mbus_str_encode(str_encoded, mbus_data_fixed_unit(data->cnt1_type), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Unit\": \"%s\",\n", str_encoded);
+
+	int val = 0;
+	if ((data->status & MBUS_DATA_FIXED_STATUS_FORMAT_MASK) == MBUS_DATA_FIXED_STATUS_FORMAT_BCD) {
+		len += snprintf(&buff[len], buff_size - len, "\"Value\": \"%llX\"\n", mbus_data_bcd_decode_hex(data->cnt1_val, 4));
+	} else {
+		mbus_data_int_decode(data->cnt1_val, 4, &val);
+		len += snprintf(&buff[len], buff_size - len, "\"Value\": %d\n", val);
+	}
+
+	len += snprintf(&buff[len], buff_size - len, "},\n{\n");
+
+	mbus_str_encode(str_encoded, mbus_data_fixed_function(data->status), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Function\": \"%s\",\n", str_encoded);
+
+	mbus_str_encode(str_encoded, mbus_data_fixed_unit(data->cnt2_type), sizeof(str_encoded));
+	len += snprintf(&buff[len], buff_size - len, "\"Unit\": \"%s\",\n", str_encoded);
+
+	if ((data->status & MBUS_DATA_FIXED_STATUS_FORMAT_MASK) == MBUS_DATA_FIXED_STATUS_FORMAT_BCD) {
+		len += snprintf(&buff[len], buff_size - len, "\"Value\": \"%llX\"\n", mbus_data_bcd_decode_hex(data->cnt2_val, 4));
+	} else {
+		mbus_data_int_decode(data->cnt2_val, 4, &val);
+		len += snprintf(&buff[len], buff_size - len, "\"Value\": %d\n", val);
+	}
+
+	len += snprintf(&buff[len], buff_size - len, "}\n]\n}\n");
+
+	return buff;
+}
+
+char *mbus_data_variable_json(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p)
+{
+	size_t len = 0, buff_size = BUFF_SIZE;
+
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return NULL;
+	}
+
+	len += snprintf(&buff[len], buff_size - len, "{\n \"MBusData\": {");
+
+	if (p->manufacturer_info) {
+		add_manufacturer_info(buff, &len, buff_size, frame_data, DATA_TYPE_JSON);
+	}
+
+	if (is_frames_required(p)) {
+		len += snprintf(&buff[len], buff_size - len, "}\n}"); // end MBusData object
+		return buff;
+	}
+
+	if (p->manufacturer_info) {
+		len += snprintf(&buff[len], buff_size - len, ",\n");
+	}
+	len += snprintf(&buff[len], buff_size - len, "\"DataRecord\": [\n");
+
+    	int frames_added = 0, frame_cnt = 0, record_cnt = 0;
+	for (mbus_frame *iter = frame; iter; iter = iter->next, frame_cnt++) {
+		if (mbus_frame_data_parse(iter, &frame_data) == -1) {
+			mbus_error_str_set("M-bus variable data parse error.");
+			return NULL;
+		}
+
+		struct frame_preset *fp = get_frame(p, frame_cnt);
+		if (!fp) {
+			count_skipped_records(&frame_data, &record_cnt);
+			mbus_data_record_free(frame_data.data_var.record);
+			continue;
+		}
+
+		if (handle_records_json(&buff, &len, &buff_size, &record_cnt, frame_cnt, &frame_data, &(frame_data.data_var.header), fp) < 0) {
+			return NULL;
+		}
+
+		if (p->take_all_frames) {
+			len += snprintf(&buff[len], buff_size - len, "%s", (iter->next) ? ",\n" : "\n");
+		} else {
+			len += snprintf(&buff[len], buff_size - len, "%s", (frames_added < (int)(p->frame_count - 1)) ? ",\n" : "\n");
+			frames_added++;
+		}
+	}
+
+    	len += snprintf(&buff[len], buff_size - len, "]\n}\n}");
+
+	return buff;
+}
+
+static int handle_records_json(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			  mbus_frame_data *frame_data, mbus_data_variable_header *header, struct frame_preset *fp)
+{
+	mbus_data_record *record = NULL;
+	int records_added = 0;
+	// loop through all records in the current frame
+	for (record = frame_data->data_var.record; record; record = record->next, (*record_cnt)++) {
+	struct record_preset *rp = get_record(fp, (*record_cnt));
+		if (!rp) {
+			continue;
+		}
+
+		*buff = check_and_expand_buffer(*buff, len, buff_size);
+		if (!buff) {
+			mbus_data_record_free(frame_data->data_var.record);
+			return -1;
+		}
+
+		if (rp->take_all_parameters) {
+			*len += snprintf(*buff + *len, *buff_size - *len, "{\n");
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+				mbus_data_variable_record_json_no_preset(record, *record_cnt, frame_cnt, header));
+			*len += snprintf(*buff + *len, *buff_size - *len, "}%s\n", (record->next) ? "," : "");
+		} else {
+			*len += snprintf(*buff + *len, *buff_size - *len, "{\n");
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+				mbus_data_variable_record_json(record, *record_cnt, frame_cnt, header, rp));
+			*len += snprintf(*buff + *len, *buff_size - *len, "}%s\n",  (records_added < (int)(fp->record_count - 1)) ? "," : "");
+		}
+
+		records_added++;
+	}
+
+	if (frame_data->data_var.record) {
+		mbus_data_record_free(frame_data->data_var.record);
+	}
+
+	return 0;
+}
+
+static char *mbus_data_variable_record_json(mbus_data_record *record, int record_cnt, int frame_cnt,
+					    mbus_data_variable_header *header, struct record_preset *rp)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768]  = { 0 };
+	size_t len	       = 0;
+
+	if (!record) {
+		return "";
+	}
+
+    long tariff = mbus_data_record_tariff(record);
+    for (size_t i = 0; i < rp->parameter_count; i++) {
+        switch (rp->parameters[i]) {
+        case INDEX_RECORD_ID:
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"id\": \"%d\"", record_cnt);
+            break;
+        case INDEX_FRAME_ID:
+            if (frame_cnt >= 0) {
+                len += snprintf(&buff[len], sizeof(buff) - len, "\"frame\": \"%d\"", frame_cnt);
+            }
+            break;
+        case INDEX_FUNCTION:
+            if (record->drh.dib.dif ==
+                MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) { // MBUS_DIB_DIF_VENDOR_SPECIFIC
+                len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"Manufacturer specific\"");
+            } else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+                len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"More records follow\"");
+            } else {
+                mbus_str_encode(str_encoded, mbus_data_record_function(record), sizeof(str_encoded));
+                len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"%s\"", str_encoded);
+            }
+            break;
+        case INDEX_STORAGE_NUMBER:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+                continue;
+            }
+        	len += snprintf(&buff[len], sizeof(buff) - len, "\"StorageNumber\": \"%ld\"",
+        			mbus_data_record_storage_number(record));
+            break;
+        case INDEX_TARIFF:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW || tariff < 0) {
+                continue;
+            }
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"Tariff\": \"%ld\"", tariff);
+            break;
+        case INDEX_DEVICE:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW || tariff < 0) {
+                continue;
+            }
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"Device\": \"%d\"",
+                    mbus_data_record_device(record));
+            break;
+        case INDEX_UNIT:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+                continue;
+            }
+            mbus_str_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"Unit\": \"%s\"\n", str_encoded);
+            break;
+        case INDEX_VALUE:
+            mbus_str_encode(str_encoded, mbus_data_record_value(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"Value\": \"%s\"", str_encoded);
+            break;
+        case INDEX_TIMESTAMP:
+            if (record->timestamp > 0) {
+                char timestamp[22]     = { 0 };
+                struct tm *timeinfo = gmtime(&(record->timestamp));
+                strftime(timestamp, 21, "%Y-%m-%dT%H:%M:%SZ", timeinfo);
+                len += snprintf(&buff[len], sizeof(buff) - len, "\"Timestamp\": \"%s\"", timestamp);
+            }
+            break;
+        default:
+            len += snprintf(&buff[len], sizeof(buff) - len, "\"error\": \"parameter with ID %d was not found\"", rp->parameters[i]);
+            break;
+        }
+        len += snprintf(&buff[len], sizeof(buff) - len, "%s", (i < rp->parameter_count - 1) ? ",\n" : "\n");
+    }
+
+	return buff;
+}
+
+static char *mbus_data_variable_record_json_no_preset(mbus_data_record *record, int record_cnt, int frame_cnt,
+					    mbus_data_variable_header *header)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768]  = { 0 };
+	size_t len	       = 0;
+	char timestamp[22]     = { 0 };
+
+	if (!record) {
+		return "";
+	}
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"id\": \"%d\",\n", record_cnt);
+
+	if (frame_cnt >= 0) {
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"frame\": \"%d\",\n", frame_cnt);
+	}
+
+	if (record->drh.dib.dif ==
+		MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) { // MBUS_DIB_DIF_VENDOR_SPECIFIC
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"Manufacturer specific\",\n");
+	} else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"More records follow\",\n");
+	} else {
+		mbus_str_encode(str_encoded, mbus_data_record_function(record), sizeof(str_encoded));
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"Function\": \"%s\",\n", str_encoded);
+
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"StorageNumber\": \"%ld\",\n",
+				mbus_data_record_storage_number(record));
+
+		long tariff = 0;
+		if ((tariff = mbus_data_record_tariff(record)) >= 0) {
+			len += snprintf(&buff[len], sizeof(buff) - len, "\"Tariff\": \"%ld\",\n", tariff);
+			len += snprintf(&buff[len], sizeof(buff) - len, "\"Device\": \"%d\",\n",
+					mbus_data_record_device(record));
+		}
+
+		mbus_str_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"Unit\": \"%s\",\n", str_encoded);
+	}
+
+	mbus_str_encode(str_encoded, mbus_data_record_value(record), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Value\": \"%s\",\n", str_encoded);
+
+	if (record->timestamp > 0) {
+		struct tm *timeinfo = gmtime(&(record->timestamp));
+		strftime(timestamp, 21, "%Y-%m-%dT%H:%M:%SZ", timeinfo);
+		len += snprintf(&buff[len], sizeof(buff) - len, "\"Timestamp\": \"%s\"\n", timestamp);
+	}
+
+	return buff;
+}
+
+char *mbus_data_variable_header_json(mbus_data_variable_header *header)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768] = { 0 };
+	size_t len = 0;
+
+	if (!header) {
+		goto end;
+	}
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"SlaveInformation\": {\n");
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"SecondaryAddress\": \"%s\",\n", mbus_data_get_secondary_address(header));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Id\": \"%llX\",\n", mbus_data_bcd_decode_hex(header->id_bcd, 4));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Manufacturer\": \"%s\",\n",
+		mbus_decode_manufacturer(header->manufacturer[0], header->manufacturer[1]));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Version\": \"%d\",\n", header->version);
+
+	mbus_str_encode(str_encoded, mbus_data_product_name(header), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"ProductName\": \"%s\",\n", str_encoded);
+
+	mbus_str_encode(str_encoded, mbus_data_variable_medium_lookup(header->medium), sizeof(str_encoded));
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Medium\": \"%s\",\n", str_encoded);
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"AccessNumber\": \"%d\",\n", header->access_no);
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Status\": \"%.2X\",\n", header->status);
+	len += snprintf(&buff[len], sizeof(buff) - len, "\"Signature\": \"%.2X%.2X\"\n", header->signature[1], header->signature[0]);
+
+	len += snprintf(&buff[len], sizeof(buff) - len, "}");
+	buff[len] = '\0';
+
+	return buff;
+
+end:
+	return "";
+}
