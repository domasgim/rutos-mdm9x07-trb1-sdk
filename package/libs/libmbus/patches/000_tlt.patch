diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/mbus/format/mbus-format.c src/mbus/format/mbus-format.c
--- upstream/mbus/format/mbus-format.c	1970-01-01 00:00:00.000000000 +0000
+++ src/mbus/format/mbus-format.c	2025-05-20 10:47:57.000000000 +0000
@@ -0,0 +1,138 @@
+#include "mbus-format-helpers.h"
+#include "mbus-format.h"
+
+#include "mbus-format-xml.h"
+#include "mbus-format-json.h"
+#include "mbus-format-ascii.h"
+#include "mbus-format-csv.h"
+
+struct methods {
+	char *(*error_cb)(int error);
+	char *(*fixed_cb)(mbus_data_fixed *data);
+	char *(*variable_cb)(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p);
+};
+
+static struct methods init_data_types(enum data_type type);
+static char *mbus_data_error_custom(struct methods *m, int error);
+static char *mbus_data_fixed_custom(struct methods *m, mbus_data_fixed *data);
+static char *mbus_data_variable_custom(struct methods *m, mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p);
+
+char *mbus_frame_custom(mbus_frame *frame, enum data_type type, struct value_preset *p)
+{
+	if (!frame) {
+		return NULL;
+	}
+
+	mbus_frame_data frame_data = { 0 };
+	if (mbus_frame_data_parse(frame, &frame_data) == -1) {
+		mbus_error_str_set("M-bus data parse error.");
+		return NULL;
+	}
+
+	struct methods m = init_data_types(type);
+
+	char *buff = NULL;
+	switch(frame_data.type) {
+	case MBUS_DATA_TYPE_ERROR:
+		buff = mbus_data_error_custom(&m, frame_data.error);
+		break;
+	case MBUS_DATA_TYPE_FIXED:
+		buff = mbus_data_fixed_custom(&m, &frame_data.data_fix);
+		break;
+	case MBUS_DATA_TYPE_VARIABLE:
+		buff = mbus_data_variable_custom(&m, frame, frame_data, p);
+		break;
+	}
+
+	mbus_data_record_free(frame_data.data_var.record);
+	return buff;
+}
+
+static struct methods init_data_types(enum data_type type)
+{
+	struct methods m = { 0 };
+
+	if (type == DATA_TYPE_XML) {
+		m.error_cb    = mbus_data_error_xml;
+		m.fixed_cb    = mbus_data_fixed_xml;
+		m.variable_cb = mbus_data_variable_xml_custom;
+	} else if (type == DATA_TYPE_JSON) {
+		m.error_cb    = mbus_data_error_json;
+		m.fixed_cb    = mbus_data_fixed_json;
+		m.variable_cb = mbus_data_variable_json;
+	} else if (type == DATA_TYPE_ASCII) {
+		m.error_cb    = mbus_data_error_ascii;
+		m.fixed_cb    = mbus_data_fixed_ascii;
+		m.variable_cb = mbus_data_variable_ascii;
+	}
+
+	return m;
+}
+
+static char *mbus_data_error_custom(struct methods *m, int error)
+{
+	return m->error_cb(error);
+}
+
+static char *mbus_data_fixed_custom(struct methods *m, mbus_data_fixed *data)
+{
+	return m->fixed_cb(data);
+}
+
+static char *mbus_data_variable_custom(struct methods *m, mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p)
+{
+	return m->variable_cb(frame, frame_data, p);
+}
+
+char *mbus_frame_custom_csv(mbus_frame *frame, struct value_preset *p, struct csv_information *csv)
+{
+	if (!frame) {
+		return NULL;
+	}
+
+	mbus_frame_data frame_data = { 0 };
+	if (mbus_frame_data_parse(frame, &frame_data) == -1) {
+		mbus_error_str_set("M-bus data parse error.");
+		return NULL;
+	}
+
+	char *b = mbus_data_variable_csv(frame, frame_data, p, csv);
+	mbus_data_record_free(frame_data.data_var.record);
+	return b;
+}
+
+char *generate_csv_header(struct csv_information *csv)
+{
+	static char buff[256] = { 0 };
+
+	int len = snprintf(&buff[len], sizeof(buff) - len, "PrimaryAddress,SecondaryAddress,");
+
+	if (csv->manufacturer_info) {
+		len += snprintf(&buff[len], sizeof(buff) - len, "Id, Manufacturer, Version, ProductName, Medium, AccessNumber, Status, Signature,");
+	}
+
+	if (csv->take_all) {
+		len += snprintf(&buff[len], sizeof(buff) - len, "%s", generate_csv_header_all());
+	} else {
+		len += snprintf(&buff[len], sizeof(buff) - len, "%s", generate_csv_header_custom(csv));
+	}
+
+	return buff;
+}
+
+void add_manufacturer_info(char *buff, size_t *len, size_t buff_size, mbus_frame_data frame_data, enum data_type type)
+{
+	if (type == DATA_TYPE_XML) {
+		*len += snprintf(&buff[*len], buff_size - *len, "%s",
+			mbus_data_variable_header_xml(&(frame_data.data_var.header)));
+	} else if (type == DATA_TYPE_JSON) {
+		*len += snprintf(&buff[*len], buff_size - *len, "%s",
+			mbus_data_variable_header_json(&(frame_data.data_var.header)));
+	} else if (type == DATA_TYPE_ASCII) {
+		*len += snprintf(&buff[*len], buff_size - *len, "%s",
+			mbus_data_variable_header_ascii(&(frame_data.data_var.header)));
+	} else if (type == DATA_TYPE_CSV) {
+		*len += snprintf(&buff[*len], buff_size - *len, "%s",
+			mbus_data_variable_header_csv(&(frame_data.data_var.header)));
+	}
+}
