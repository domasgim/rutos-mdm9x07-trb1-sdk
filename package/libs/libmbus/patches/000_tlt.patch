+//------------------------------------------------------------------------------
+/// Generate XML for the variable-length data header
+//------------------------------------------------------------------------------
+char *mbus_data_variable_header_xml(mbus_data_variable_header *header)
+{
+    static char buff[BUFF_SIZE];
+    char str_encoded[768];
+    size_t len = 0;
+
+    if (header)
+    {
+        len += snprintf(&buff[len], sizeof(buff) - len, "    <SlaveInformation>\n");
+
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <SecondaryAddress>%s</SecondaryAddress>\n", mbus_data_get_secondary_address(header));
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Id>%llX</Id>\n", mbus_data_bcd_decode_hex(header->id_bcd, 4));
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Manufacturer>%s</Manufacturer>\n",
+                mbus_decode_manufacturer(header->manufacturer[0], header->manufacturer[1]));
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Version>%d</Version>\n", header->version);
+
+        mbus_str_xml_encode(str_encoded, mbus_data_product_name(header), sizeof(str_encoded));
+
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <ProductName>%s</ProductName>\n", str_encoded);
+
+        mbus_str_xml_encode(str_encoded, mbus_data_variable_medium_lookup(header->medium), sizeof(str_encoded));
+
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Medium>%s</Medium>\n", str_encoded);
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <AccessNumber>%d</AccessNumber>\n", header->access_no);
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Status>%.2X</Status>\n", header->status);
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Signature>%.2X%.2X</Signature>\n", header->signature[1], header->signature[0]);
+
+        len += snprintf(&buff[len], sizeof(buff) - len, "    </SlaveInformation>\n\n");
+
+        return buff;
+    }
+
+    return "";
+}
+
+//------------------------------------------------------------------------------
+/// Generate XML for a single variable-length data record
+//------------------------------------------------------------------------------
+char *
+mbus_data_variable_record_xml(mbus_data_record *record, int record_cnt, int frame_cnt, mbus_data_variable_header *header)
+{
+    static char buff[BUFF_SIZE];
+    char str_encoded[768];
+    size_t len = 0;
+    struct tm * timeinfo;
+    char timestamp[22];
+    long tariff;
+
+    if (record)
+    {
+        if (frame_cnt >= 0)
+        {
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "    <DataRecord id=\"%d\" frame=\"%d\">\n",
+                            record_cnt, frame_cnt);
+        }
+        else
+        {
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "    <DataRecord id=\"%d\">\n", record_cnt);
+        }
+
+        if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) // MBUS_DIB_DIF_VENDOR_SPECIFIC
+        {
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Function>Manufacturer specific</Function>\n");
+        }
+        else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW)
+        {
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Function>More records follow</Function>\n");
+        }
+        else
+        {
+            mbus_str_xml_encode(str_encoded, mbus_data_record_function(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Function>%s</Function>\n", str_encoded);
+
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <StorageNumber>%ld</StorageNumber>\n",
+                            mbus_data_record_storage_number(record));
+
+            if ((tariff = mbus_data_record_tariff(record)) >= 0)
+            {
+                len += snprintf(&buff[len], sizeof(buff) - len, "        <Tariff>%ld</Tariff>\n",
+                                tariff);
+                len += snprintf(&buff[len], sizeof(buff) - len, "        <Device>%d</Device>\n",
+                                mbus_data_record_device(record));
+            }
+
+            mbus_str_xml_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Unit>%s</Unit>\n", str_encoded);
+        }
+
+        mbus_str_xml_encode(str_encoded, mbus_data_record_value(record), sizeof(str_encoded));
+        len += snprintf(&buff[len], sizeof(buff) - len, "        <Value>%s</Value>\n", str_encoded);
+
+        if (record->timestamp > 0)
+        {
+            timeinfo = gmtime (&(record->timestamp));
+            strftime(timestamp,21,"%Y-%m-%dT%H:%M:%SZ",timeinfo);
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Timestamp>%s</Timestamp>\n", timestamp);
+        }
+
+        len += snprintf(&buff[len], sizeof(buff) - len, "    </DataRecord>\n\n");
+
+        return buff;
+    }
+
+    return "";
+}
+
+char *mbus_data_variable_xml_custom(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p)
+{
+	size_t len = 0, buff_size = BUFF_SIZE;
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return NULL;
+	}
+
+    // len += snprintf(&buff[len], buff_size - len, MBUS_XML_PROCESSING_INSTRUCTION);
+    len += snprintf(&buff[len], buff_size - len, "<MBusData>\n\n");
+
+    if (p->manufacturer_info) {
+        add_manufacturer_info(buff, &len, buff_size, frame_data, DATA_TYPE_XML);
+    }
+
+    if (is_frames_required(p)) {
+        len += snprintf(&buff[len], buff_size - len, "</MBusData>\n"); // end xml if data is needed
+        return buff;
+    }
+
+    int frames_added = 0, frame_cnt = 0, record_cnt = 0;
+	for (mbus_frame *iter = frame; iter; iter = iter->next, frame_cnt++) {
+
+		if (mbus_frame_data_parse(iter, &frame_data) == -1) {
+			mbus_error_str_set("M-bus variable data parse error.");
+			return NULL;
+		}
+
+        struct frame_preset *fp = get_frame(p, frame_cnt);
+        if (!fp) {
+            count_skipped_records(&frame_data, &record_cnt);
+            mbus_data_record_free(frame_data.data_var.record);
+            continue;
+        }
+
+		if (handle_records_xml(&buff, &len, &buff_size, &record_cnt, frame_cnt, &frame_data, &(frame_data.data_var.header), fp) < 0) {
+			return NULL;
+		}
+	}
+
+    len += snprintf(&buff[len], buff_size - len, "</MBusData>\n");
+
+    return buff;
+}
+
+static int handle_records_xml(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			  mbus_frame_data *frame_data, mbus_data_variable_header *header, struct frame_preset *fp)
+{
+	mbus_data_record *record = NULL;
+
+	// loop through all records in the current frame
+	for (record = frame_data->data_var.record; record; record = record->next, (*record_cnt)++) {
+       struct record_preset *rp = get_record(fp, (*record_cnt));
+        if (!rp) {
+            continue;
+        }
+
+		*buff = check_and_expand_buffer(*buff, len, buff_size);
+		if (!buff) {
+			mbus_data_record_free(frame_data->data_var.record);
+			return -1;
+		}
+
+        if (rp->take_all_parameters) {
+            *len += snprintf(*buff + *len, *buff_size - *len, "%s",
+                            mbus_data_variable_record_xml(record, *record_cnt, frame_cnt, header));
+        } else {
+            add_frame_and_id(buff, len, *buff_size, *record_cnt, frame_cnt, rp);
+            *len += snprintf(*buff + *len, *buff_size - *len, "%s",
+                            mbus_data_variable_record_xml_custom(record, header, rp));
+            *len += snprintf(*buff + *len, *buff_size - *len, "    </DataRecord>\n\n");
+        }
+	}
+
+	// free all records in the list
+	if (frame_data->data_var.record) {
+		mbus_data_record_free(frame_data->data_var.record);
+	}
+
+	return 0;
+}
+
+char *
+mbus_data_variable_record_xml_custom(mbus_data_record *record, mbus_data_variable_header *header, struct record_preset *rp)
+{
+    static char buff[BUFF_SIZE];
+    char str_encoded[768];
+    size_t len = 0;
+
+	if (!record) {
+		return "";
+	}
+
+    long tariff = mbus_data_record_tariff(record);
+    for (size_t i = 0; i < rp->parameter_count; i++) {
+        switch (rp->parameters[i]) {
+        case INDEX_FUNCTION:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) // MBUS_DIB_DIF_VENDOR_SPECIFIC
+            {
+                len += snprintf(&buff[len], sizeof(buff) - len,
+                                "        <Function>Manufacturer specific</Function>\n");
+            }
+            else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW)
+            {
+                len += snprintf(&buff[len], sizeof(buff) - len,
+                                "        <Function>More records follow</Function>\n");
+            }
+            else
+            {
+                mbus_str_xml_encode(str_encoded, mbus_data_record_function(record), sizeof(str_encoded));
+                len += snprintf(&buff[len], sizeof(buff) - len,
+                                "        <Function>%s</Function>\n", str_encoded);
+            }
+            break;
+        case INDEX_STORAGE_NUMBER:
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <StorageNumber>%ld</StorageNumber>\n",
+                            mbus_data_record_storage_number(record));
+            break;
+        case INDEX_TARIFF:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+                continue;
+            }
+            if (tariff >= 0) {
+                len += snprintf(&buff[len], sizeof(buff) - len, "        <Tariff>%ld</Tariff>\n",
+                                tariff);
+            }
+            break;
+        case INDEX_DEVICE:
+            if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC || record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+                continue;
+            }
+            if (tariff >= 0) {
+            len += snprintf(&buff[len], sizeof(buff) - len, "        <Device>%d</Device>\n",
+                            mbus_data_record_device(record));
+            }
+            break;
+        case INDEX_UNIT:
+            mbus_str_xml_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len,
+                            "        <Unit>%s</Unit>\n", str_encoded);
+            break;
+        case INDEX_VALUE:
+            mbus_str_xml_encode(str_encoded, mbus_data_record_value(record), sizeof(str_encoded));
+            len += snprintf(&buff[len], sizeof(buff) - len, "        <Value>%s</Value>\n", str_encoded);
+            break;
+        case INDEX_TIMESTAMP:
+            if (record->timestamp > 0)
+            {
+                char timestamp[22] = { 0 };
+                struct tm *timeinfo = gmtime (&(record->timestamp));
+                strftime(timestamp,21,"%Y-%m-%dT%H:%M:%SZ",timeinfo);
+                len += snprintf(&buff[len], sizeof(buff) - len,
+                                "        <Timestamp>%s</Timestamp>\n", timestamp);
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    return buff;
+}
+
+
+static void add_frame_and_id(char **buff, size_t *len, size_t buff_size, int record_cnt, int frame_cnt, struct record_preset *rp)
+{
+    int id = 0, frame = 0;
+    for (size_t i = 0; i < rp->parameter_count; i++) {
+        switch (rp->parameters[i]) {
+            case INDEX_RECORD_ID:
+                id = 1;
+                break;
+            case INDEX_FRAME_ID:
+                frame = 1;
+                break;
+        }
+    }
+
+    if (id && frame) {
+        *len += snprintf(*buff + *len, buff_size - *len, "    <DataRecord id=\"%d\" frame=\"%d\">\n",
+                record_cnt, frame_cnt);
+    } else if (id) {
+        *len += snprintf(*buff + *len, buff_size - *len, "    <DataRecord id=\"%d\">\n", record_cnt);
+    } else if (frame) {
+        *len += snprintf(*buff + *len, buff_size - *len, "    <DataRecord frame=\"%d\">\n", frame_cnt);
+    } else {
+        *len += snprintf(*buff + *len, buff_size - *len, "    <DataRecord>\n");
+    }
+}
diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/mbus/format/mbus-format-xml.h src/mbus/format/mbus-format-xml.h
