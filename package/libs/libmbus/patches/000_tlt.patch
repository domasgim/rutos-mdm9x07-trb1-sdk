+char *check_and_expand_buffer(char *buff, size_t *len, size_t *buff_size)
+{
+	if ((*buff_size - *len) < 1024) {
+		*buff_size *= 2;
+		char *new_buff = (char*) realloc(buff, *buff_size);
+		if (!new_buff) {
+			free(buff);
+			return NULL;
+		}
+
+		buff = new_buff;
+	}
+
+	return buff;
+}
+
+const char *mbus_data_get_secondary_address(mbus_data_variable_header *header)
+{
+    static char buff[16] = { 0 };
+    unsigned int manufacturer;
+
+    int len = 0;
+    len += snprintf(buff + len, sizeof(buff), "%llX", mbus_data_bcd_decode_hex(header->id_bcd, 4));
+
+    for (size_t i = 0; i < sizeof(header->manufacturer); i++) {
+        len += snprintf(buff + len, sizeof(buff), "%02X", header->manufacturer[i]);
+    }
+
+    len += snprintf(buff + len, sizeof(buff), "%02X", header->version);
+    len += snprintf(buff + len, sizeof(buff), "%02X", header->medium);
+
+    return buff;
+}
+
+int is_frames_required(struct value_preset *p)
+{
+    return (!p->frame_count && !p->take_all_frames);
+}
+
+struct record_preset *get_record(struct frame_preset *fp, const int target_record)
+{
+    if (fp->take_all_records) {
+        return &fp->records[0];
+    }
+
+    for (size_t i = 0; i < fp->record_count; i++) {
+        if (fp->records[i].record_num == target_record) {
+            return &fp->records[i];
+        }
+    }
+
+    return NULL;
+}
+
+struct frame_preset *get_frame(struct value_preset *vp, const int target_frame)
+{
+    if (vp->take_all_frames) {
+        return &vp->frames[0];
+    }
+
+    for (size_t i = 0; i < vp->frame_count; i++) {
+        if (vp->frames[i].frame_num == target_frame) {
+            return &vp->frames[i];
+        }
+    }
+
+    return NULL;
+}
+
+void count_skipped_records(mbus_frame_data *frame_data, int *record_cnt)
+{
+    for (mbus_data_record *record = frame_data->data_var.record; record; record = record->next, (*record_cnt)++);
+}
+
+int mbus_str_encode(char *dst, const char *src, size_t max_len)
+{
+    size_t i = 0, len = 0;
+
+    if (!dst) {
+        return -1;
+    }
+
+    if (!src) {
+        dst[len] = '\0';
+        return -2;
+    }
+
+    while((len+6) < max_len) {
+        if (src[i] == '\0') {
+            break;
+        }
+
+	switch (src[i]) {
+	case '"':
+		len += snprintf(&dst[len], max_len - len, "\\\"");
+		break;
+	case '\\':
+		len += snprintf(&dst[len], max_len - len, "\\\\");
+		break;
+	case '/':
+		len += snprintf(&dst[len], max_len - len, "\\/");
+		break;
+	case '\b':
+		len += snprintf(&dst[len], max_len - len, "\\b");
+		break;
+	case '\f':
+		len += snprintf(&dst[len], max_len - len, "\\f");
+		break;
+	case '\n':
+		len += snprintf(&dst[len], max_len - len, "\\n");
+		break;
+	case '\r':
+		len += snprintf(&dst[len], max_len - len, "\\r");
+		break;
+	case '\t':
+		len += snprintf(&dst[len], max_len - len, "\\t");
+		break;
+	default:
+		dst[len++] = src[i];
+		break;
+	}
+
+        i++;
+    }
+
+    dst[len] = '\0';
+    return 0;
+}
+
+/**
+ * @brief Get parameter value from a specific record in a frame
+ * 
+ * @param frame Frame structure containing the data to parse
+ * @param frame_id Target frame ID to look for
+ * @param record_id Target record ID to look for
+ * @param param_id Parameter index to extract (use enum PARAMETER_INDEXES)
+ * @param buffer Buffer to store the result
+ * @param buffer_size Size of the buffer
+ * @return int 0 on success, negative on error
+ */
+int mbus_get_parameter_value(mbus_frame *frame, int frame_id, int record_id, int param_id, char *buffer,
+			     size_t buffer_size)
+{
+	if (!frame || !buffer || buffer_size == 0) {
+		return -1;
+	}
+
+	memset(buffer, 0, buffer_size);
+
+	// Find the requested frame
+	mbus_frame *current_frame = frame;
+	int current_frame_id	  = 0;
+
+	int current_record_id		 = 0;
+	mbus_data_record *current_record = NULL;
+
+	while (current_frame && current_frame_id != frame_id) {
+		mbus_frame_data frame = { 0 };
+
+		if (mbus_frame_data_parse(current_frame, &frame) == -1) {
+			mbus_error_str_set("M-bus data parse error.");
+			return -2;
+		}
+
+		// We need to increment record ID because for some reason it is always incremented instead of starting from 0 each frame
+		current_record_id += frame.data_var.nrecords;
+		current_frame = current_frame->next;
+		current_frame_id++;
+
+		mbus_data_record_free(frame.data_var.record);
+	}
+
+	if (!current_frame) {
+		return -3; // Frame not found
+	}
+
+	mbus_frame_data frame_data = { 0 };
+	if (mbus_frame_data_parse(current_frame, &frame_data) == -1) {
+		mbus_error_str_set("M-bus data parse error.");
+		return -2;
+	}
+
+	if (frame_data.type == MBUS_DATA_TYPE_ERROR) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return -2; // Error in frame data
+	}
+
+	// Find the requested record
+	current_record = frame_data.data_var.record;
+
+	while (current_record && current_record_id != record_id) {
+		current_record = current_record->next;
+		current_record_id++;
+	}
+
+	if (!current_record) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return -3; // Record not found
+	}
+
+	// Process the requested parameter
+	int rc = 0;
+
+	switch (param_id) {
+	case INDEX_RECORD_ID:
+		snprintf(buffer, buffer_size, "%d", current_record_id);
+		break;
+
+	case INDEX_FRAME_ID:
+		snprintf(buffer, buffer_size, "%d", current_frame_id);
+		break;
+
+	case INDEX_FUNCTION: {
+		unsigned char dif    = current_record->drh.dib.dif;
+		const char *function = NULL;
+
+		// Map function code to string description
+		if ((dif & 0x30) == 0x00) {
+			function = "Instantaneous value";
+		} else if ((dif & 0x30) == 0x10) {
+			function = "Maximum value";
+		} else if ((dif & 0x30) == 0x20) {
+			function = "Minimum value";
+		} else if ((dif & 0x30) == 0x30) {
+			function = "Value during error state";
+		} else {
+			function = "Unknown function";
+		}
+
+		strncpy(buffer, function, buffer_size - 1);
+	} break;
+
+	case INDEX_STORAGE_NUMBER:
+		snprintf(buffer, buffer_size, "%ld", mbus_data_record_storage_number(current_record));
+		break;
+
+	case INDEX_TARIFF:
+		snprintf(buffer, buffer_size, "%ld", mbus_data_record_tariff(current_record));
+		break;
+
+	case INDEX_DEVICE:
+		snprintf(buffer, buffer_size, "%d", mbus_data_record_device(current_record));
+		break;
+
+	case INDEX_UNIT: {
+		const char *unit = mbus_vif_unit_lookup(current_record->drh.vib.vif);
+		if (unit) {
+			strncpy(buffer, unit, buffer_size - 1);
+		} else {
+			snprintf(buffer, buffer_size, "Unknown unit (0x%.2x)", current_record->drh.vib.vif);
+		}
+	} break;
+
+	case INDEX_VALUE: {
+		unsigned char dif   = current_record->drh.dib.dif;
+		unsigned char *data = current_record->data;
+
+		// Decode value based on the DIF data format
+		switch (dif & 0x0F) {
+		case 0x00: // No data
+			buffer[0] = '\0';
+			break;
+
+		case 0x01: // 8 Bit Integer/Binary
+			snprintf(buffer, buffer_size, "%d", *data);
+			break;
+
+		case 0x02: // 16 Bit Integer/Binary
+		{
+			int value;
+			mbus_data_int_decode(data, 2, &value);
+			snprintf(buffer, buffer_size, "%d", value);
+		} break;
+
+		case 0x03: // 24 Bit Integer/Binary
+		{
+			int value;
+			mbus_data_int_decode(data, 3, &value);
+			snprintf(buffer, buffer_size, "%d", value);
+		} break;
+
+		case 0x04: // 32 Bit Integer/Binary
+		{
+			long value;
+			mbus_data_long_decode(data, 4, &value);
+			snprintf(buffer, buffer_size, "%ld", value);
+		} break;
+
+		case 0x05: // 32 Bit Real
+		{
+			float value = mbus_data_float_decode(data);
+			snprintf(buffer, buffer_size, "%.6f", value);
+		} break;
+
+		case 0x06: // 48 Bit Integer/Binary
+		{
+			long long value;
+			mbus_data_long_long_decode(data, 6, &value);
+			snprintf(buffer, buffer_size, "%lld", value);
+		} break;
+
+		case 0x07: // 64 Bit Integer/Binary
+		{
+			long long value;
+			mbus_data_long_long_decode(data, 8, &value);
+			snprintf(buffer, buffer_size, "%lld", value);
+		} break;
+
+		case 0x09: // 2 digit BCD
+			snprintf(buffer, buffer_size, "%lld", mbus_data_bcd_decode(data, 1));
+			break;
+
+		case 0x0A: // 4 digit BCD
+			snprintf(buffer, buffer_size, "%lld", mbus_data_bcd_decode(data, 2));
+			break;
+
+		case 0x0B: // 6 digit BCD
+			snprintf(buffer, buffer_size, "%lld", mbus_data_bcd_decode(data, 3));
+			break;
+
+		case 0x0C: // 8 digit BCD
+			snprintf(buffer, buffer_size, "%lld", mbus_data_bcd_decode(data, 4));
+			break;
+
+		case 0x0E: // 12 digit BCD
+			snprintf(buffer, buffer_size, "%lld", mbus_data_bcd_decode(data, 6));
+			break;
+
+		default:
+			snprintf(buffer, buffer_size, "Unknown value format (DIF=0x%.2x)", dif);
+			break;
+		}
+	} break;
+
+	case INDEX_TIMESTAMP:
+		if (current_record->timestamp > 0) {
+			struct tm *timeinfo = gmtime(&(current_record->timestamp));
+			strftime(buffer, buffer_size, "%Y-%m-%dT%H:%M:%S", timeinfo);
+		}
+		break;
+
+	default:
+		rc = -4; // Invalid parameter ID
+		break;
+	}
+
+	mbus_data_record_free(frame_data.data_var.record);
+	return rc;
+}
