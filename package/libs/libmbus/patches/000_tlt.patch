diff --recursive --unified --new-file --no-dereference --exclude .gitver upstream/mbus/format/mbus-format-ascii.c src/mbus/format/mbus-format-ascii.c
--- upstream/mbus/format/mbus-format-ascii.c	1970-01-01 00:00:00.000000000 +0000
+++ src/mbus/format/mbus-format-ascii.c	2025-05-20 10:47:57.000000000 +0000
@@ -0,0 +1,344 @@
+#include "mbus-format-helpers.h"
+#include "mbus-format.h"
+
+int handle_records_ascii(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			  mbus_frame_data *frame_data, mbus_data_variable_header *header, struct frame_preset *fp);
+char *mbus_data_error_ascii(int error);
+char *mbus_data_fixed_ascii(mbus_data_fixed *data);
+
+char *
+mbus_data_variable_record_ascii_no_preset(mbus_data_record *record, int record_cnt, int frame_cnt, mbus_data_variable_header *header);
+char *mbus_data_variable_record_ascii(mbus_data_record *record, int record_cnt, int frame_cnt,
+					     mbus_data_variable_header *header, struct record_preset *rp);
+char *mbus_data_variable_ascii(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p);
+
+int handle_records_ascii(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			  mbus_frame_data *frame_data, mbus_data_variable_header *header, struct frame_preset *fp)
+{
+	mbus_data_record *record = NULL;
+	int records_added = 0;
+
+	for (record = frame_data->data_var.record; record; record = record->next, (*record_cnt)++) {
+		struct record_preset *rp = get_record(fp, (*record_cnt));
+		if (!rp) {
+			continue;
+		}
+
+		*buff = check_and_expand_buffer(*buff, len, buff_size);
+		if (!buff) {
+			mbus_data_record_free(frame_data->data_var.record);
+			return -1;
+		}
+
+		if (rp->take_all_parameters) {
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+				mbus_data_variable_record_ascii_no_preset(record, *record_cnt, frame_cnt, header));
+		} else {
+			*len += snprintf(*buff + *len, *buff_size - *len, "%s",
+				mbus_data_variable_record_ascii(record, *record_cnt, frame_cnt, header, rp));
+		}
+		*len += snprintf(*buff + *len, *buff_size - *len, "%s", (records_added < (int)(fp->record_count - 1)) ? " " : "");
+		records_added++;
+	}
+
+	// free all records in the list
+	if (frame_data->data_var.record) {
+		mbus_data_record_free(frame_data->data_var.record);
+	}
+
+	return 0;
+}
+
+char *mbus_data_error_ascii(int error)
+{
+    char str_encoded[64] = { 0 };
+    size_t len = 0, buff_size = BUFF_SIZE;
+
+    char *buff = calloc(buff_size, sizeof(char));
+    if (!buff) {
+        return NULL;
+    }
+
+    mbus_str_encode(str_encoded, mbus_data_error_lookup(error), sizeof(str_encoded));
+    len += snprintf(&buff[len], buff_size - len, "%s", str_encoded);
+
+    return buff;
+}
+
+char *mbus_data_fixed_ascii(mbus_data_fixed *data)
+{
+    if (!data) {
+	return NULL;
+    }
+
+    size_t buff_size = BUFF_SIZE;
+    char *buff = calloc(buff_size, sizeof(char));
+    if (!buff) {
+        return NULL;
+    }
+
+    size_t len = 0;
+    len += snprintf(&buff[len], buff_size - len, "%llX ", mbus_data_bcd_decode_hex(data->id_bcd, 4));
+
+    char str_encoded[256] = { 0 };
+    len += snprintf(&buff[len], buff_size - len, "%s ", mbus_data_fixed_medium(data));
+
+    len += snprintf(&buff[len], buff_size - len, "%d ", data->tx_cnt);
+    len += snprintf(&buff[len], buff_size - len, "%.2X ", data->status);
+
+    len += snprintf(&buff[len], buff_size - len, "%s ", mbus_data_fixed_function(data->status));
+
+    len += snprintf(&buff[len], buff_size - len, "%s ", mbus_data_fixed_unit(data->cnt1_type));
+
+    int val = 0;
+    if ((data->status & MBUS_DATA_FIXED_STATUS_FORMAT_MASK) == MBUS_DATA_FIXED_STATUS_FORMAT_BCD) {
+        len += snprintf(&buff[len], buff_size - len, "%llX ", mbus_data_bcd_decode_hex(data->cnt1_val, 4));
+    } else {
+        mbus_data_int_decode(data->cnt1_val, 4, &val);
+        len += snprintf(&buff[len], buff_size - len, "%d ", val);
+    }
+
+    len += snprintf(&buff[len], buff_size - len, "%s ", str_encoded);
+
+    len += snprintf(&buff[len], buff_size - len, "%s ", mbus_data_fixed_unit(data->cnt2_type));
+
+    if ((data->status & MBUS_DATA_FIXED_STATUS_FORMAT_MASK) == MBUS_DATA_FIXED_STATUS_FORMAT_BCD) {
+        len += snprintf(&buff[len], buff_size - len, "%llX ", mbus_data_bcd_decode_hex(data->cnt2_val, 4));
+    } else {
+        mbus_data_int_decode(data->cnt2_val, 4, &val);
+        len += snprintf(&buff[len], buff_size - len, "%d", val);
+    }
+
+    return buff;
+}
+
+char *mbus_data_variable_ascii(mbus_frame *frame, mbus_frame_data frame_data, struct value_preset *p)
+{
+	size_t len = 0, buff_size = BUFF_SIZE;
+	char *buff = calloc(buff_size, sizeof(char));
+	if (!buff) {
+		mbus_data_record_free(frame_data.data_var.record);
+		return NULL;
+	}
+
+    if (p->manufacturer_info) {
+        add_manufacturer_info(buff, &len, buff_size, frame_data, DATA_TYPE_ASCII);
+    }
+
+    if (is_frames_required(p)) {
+        return buff;
+    }
+
+    if (p->manufacturer_info) {
+        len += snprintf(&buff[len], buff_size - len, " "); // leave space after manufacturer_info
+    }
+
+    int frames_added = 0, frame_cnt = 0, record_cnt = 0;
+	for (mbus_frame *iter = frame; iter; iter = iter->next, frame_cnt++) {
+
+		if (mbus_frame_data_parse(iter, &frame_data) == -1) {
+			mbus_error_str_set("M-bus variable data parse error.");
+			return NULL;
+		}
+
+        struct frame_preset *fp = get_frame(p, frame_cnt);
+        if (!fp) {
+            count_skipped_records(&frame_data, &record_cnt);
+            mbus_data_record_free(frame_data.data_var.record);
+            continue;
+        }
+
+		if (handle_records_ascii(&buff, &len, &buff_size, &record_cnt, frame_cnt, &frame_data, &(frame_data.data_var.header), fp) < 0) {
+			return NULL;
+		}
+	}
+
+	return buff;
+}
+
+char *mbus_data_variable_record_ascii(mbus_data_record *record, int record_cnt, int frame_cnt,
+					     mbus_data_variable_header *header, struct record_preset *rp)
+{
+	static char buff[BUFF_SIZE] = { 0 };
+	char str_encoded[768]  = { 0 };
+	size_t len	       = 0;
+
+	if (!record) {
+		return "";
+	}
+
+	long tariff = mbus_data_record_tariff(record);
+	size_t previous_len = 0;
+	int parameters_added = 0;
+	for (size_t i = 0; i < rp->parameter_count; i++) {
+		switch (rp->parameters[i]) {
+		case INDEX_RECORD_ID:
+			len += snprintf(&buff[len], sizeof(buff) - len, "%d", record_cnt);
+			break;
+		case INDEX_FRAME_ID:
+			if (frame_cnt >= 0) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "%d", frame_cnt);
+			}
+			break;
+		case INDEX_FUNCTION:
+			if (record->drh.dib.dif ==
+			    MBUS_DIB_DIF_MANUFACTURER_SPECIFIC) { // MBUS_DIB_DIF_VENDOR_SPECIFIC
+				len += snprintf(&buff[len], sizeof(buff) - len, "Manufacturer specific");
+			} else if (record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "More records follow");
+			} else {
+				mbus_str_encode(str_encoded, mbus_data_record_function(record),
+						     sizeof(str_encoded));
+				len += snprintf(&buff[len], sizeof(buff) - len, "%s", str_encoded);
+			}
+			break;
+		case INDEX_STORAGE_NUMBER:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			len += snprintf(&buff[len], sizeof(buff) - len, "%ld",
+					mbus_data_record_storage_number(record));
+			break;
+		case INDEX_TARIFF:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			if (tariff >= 0) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "%ld", tariff);
+			}
+			break;
+		case INDEX_DEVICE:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			if (tariff >= 0) {
+				len += snprintf(&buff[len], sizeof(buff) - len, "%d",
+						mbus_data_record_device(record));
+			}
+			break;
+		case INDEX_UNIT:
+			if (record->drh.dib.dif == MBUS_DIB_DIF_MANUFACTURER_SPECIFIC ||
+			    record->drh.dib.dif == MBUS_DIB_DIF_MORE_RECORDS_FOLLOW) {
+				continue;
+			}
+			mbus_str_encode(str_encoded, mbus_data_record_unit(record), sizeof(str_encoded));
+			len += snprintf(&buff[len], sizeof(buff) - len, "%s", str_encoded);
+			break;
+		case INDEX_VALUE:
+			mbus_str_encode(str_encoded, mbus_data_record_value(record),
+					     sizeof(str_encoded));
+			len += snprintf(&buff[len], sizeof(buff) - len, "%s", str_encoded);
+			break;
+		case INDEX_TIMESTAMP:
+			if (record->timestamp > 0) {
+				char timestamp[22]  = { 0 };
+				struct tm *timeinfo = gmtime(&(record->timestamp));
+				strftime(timestamp, 21, "%Y-%m-%dT%H:%M:%SZ", timeinfo);
+				len += snprintf(&buff[len], sizeof(buff) - len, "%s", timestamp);
+			}
+			break;
+		default:
+            // len += snprintf(&buff[len], sizeof(buff) - len, "<Error>parameter with ID %d was not found</Error>", rp->parameters[i]);
+			break;
+		}
+
+        // check if parameter was added previously
+        // also check if it is not last parameter
+        int a = ((previous_len == len || len == 0) || (parameters_added >= (int)(rp->parameter_count - 1)));
+        len += snprintf(&buff[len], sizeof(buff) - len, a ? "": " ");
+        previous_len = len;
+        parameters_added++;
+	}
+
+	return buff;
+}
