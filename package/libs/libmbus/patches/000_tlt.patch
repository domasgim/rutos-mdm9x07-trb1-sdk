+#include "mbus-format-helpers.h"
+#include "mbus-format.h"
+
+static int handle_records_json(char **buff, size_t *len, size_t *buff_size, int *record_cnt, int frame_cnt,
+			       mbus_frame_data *frame_data, mbus_data_variable_header *header,
+			       struct frame_preset *fp);
